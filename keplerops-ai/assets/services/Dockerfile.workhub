ARG BASE_IMAGE=gitea/gitea@sha256:137a322f0308056415bc1a14a4ca8607b2e8efcb8154dfc5049b1f7f8b0a9b71
FROM ${BASE_IMAGE} AS gitea
FROM python@sha256:5f55cdf0c5d9dc1a415637a5ccc4a9e18663ad203673173b8cda8f8dcacef689 AS runtime-wheel-builder
RUN python -m pip install --no-cache-dir build==1.3.0 setuptools==80.9.0 wheel==0.45.1
COPY assets/content/python-packages/clean-runtime/ /src/clean-runtime/
RUN python -m build --no-isolation --wheel --outdir /wheels /src/clean-runtime
FROM envoyproxy/envoy@sha256:522f4f88bdd741fe87b813bdca678a11c13e42e630cc4304a9e18193813c935d AS envoy
FROM redmine@sha256:5c4b6f3904ccd9d5c6d01b62c59294fef764923af6e5e308cf888457e2c76dcd
USER root
COPY --from=gitea /app/gitea/gitea /usr/local/bin/gitea
COPY --from=gitea /lib/ld-musl-x86_64.so.1 /lib/ld-musl-x86_64.so.1
COPY --from=gitea /lib/libc.musl-x86_64.so.1 /lib/libc.musl-x86_64.so.1
COPY --from=envoy /usr/local/bin/envoy /usr/local/bin/envoy
COPY assets/services/workhub-entrypoint.sh /usr/local/bin/workhub-entrypoint
COPY assets/services/seed_workhub.rb /usr/local/bin/seed-workhub
COPY assets/services/seed_redmine.rb /opt/keplerops/seed-redmine.rb
COPY assets/services/seed_context_access.rb /usr/local/bin/seed-context-access
COPY assets/services/seed_agent_expansion.rb /usr/local/bin/seed-agent-expansion
COPY assets/services/workhub-envoy.yaml /etc/keplerops/envoy.yaml
COPY assets/content/company-state/company-state.yaml /opt/keplerops/company-state.yaml
COPY assets/content/enterprise/ /opt/keplerops/seed/
COPY assets/content/agent-packages/ /opt/keplerops/seed/agent-packages/
COPY assets/content/model-dependencies/ /opt/keplerops/seed/model-dependencies/
COPY --from=runtime-wheel-builder /wheels/ /opt/keplerops/seed/python-packages/
RUN chmod 0755 \
      /usr/local/bin/workhub-entrypoint \
      /usr/local/bin/seed-workhub \
      /usr/local/bin/seed-context-access \
      /usr/local/bin/seed-agent-expansion \
    && install -d -o redmine -g redmine -m 0750 /data/gitea /data/gitea/conf /data/redmine \
    && printf '%s\n' \
      'production:' \
      '  adapter: sqlite3' \
      '  database: /usr/src/redmine/sqlite/redmine.db' \
      '  encoding: utf8' \
      > /usr/src/redmine/config/database.yml \
    && chown redmine:redmine /usr/src/redmine/config/database.yml \
    && chmod 0644 /usr/src/redmine/config/database.yml
EXPOSE 8443
USER redmine
ENTRYPOINT ["/usr/local/bin/workhub-entrypoint"]
