ARG BASE_IMAGE=python@sha256:5f55cdf0c5d9dc1a415637a5ccc4a9e18663ad203673173b8cda8f8dcacef689
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    EDGE_REGISTRY_DATA_ROOT=/var/lib/keplerops-edge-registry

RUN groupadd --system --gid 65532 keplerops \
    && useradd --system --uid 65532 --gid keplerops --home-dir /nonexistent keplerops \
    && install -d -o keplerops -g keplerops -m 0700 /var/lib/keplerops-edge-registry

WORKDIR /opt/keplerops/platform-isolation
COPY assets/services/platform-isolation/requirements.txt ./requirements.txt
RUN python3 -m pip install --no-cache-dir --requirement requirements.txt
COPY assets/services/platform-isolation/edge_app.py ./edge_app.py
COPY assets/services/platform-isolation/edge_state.py ./edge_state.py

USER 65532:65532
EXPOSE 8481
HEALTHCHECK --interval=10s --timeout=3s --retries=6 \
  CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8481/healthz', timeout=2).read()"]
ENTRYPOINT ["python3", "-m", "uvicorn", "edge_app:app", "--host", "0.0.0.0", "--port", "8481", "--no-access-log", "--no-proxy-headers"]
