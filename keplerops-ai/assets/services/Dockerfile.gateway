ARG BASE_IMAGE=python@sha256:5f55cdf0c5d9dc1a415637a5ccc4a9e18663ad203673173b8cda8f8dcacef689
FROM ${BASE_IMAGE} AS embedding-model
WORKDIR /opt/keplerops
COPY assets/model-artifacts/embedding-model.yaml ./embedding-model.yaml
COPY assets/model-artifacts/fetch_model.py ./fetch_model.py
RUN python -m pip install --no-cache-dir huggingface-hub==0.34.4 PyYAML==6.0.2 \
    && python ./fetch_model.py \
        --manifest ./embedding-model.yaml \
        --output /models/context-embedding

FROM envoyproxy/envoy@sha256:522f4f88bdd741fe87b813bdca678a11c13e42e630cc4304a9e18193813c935d AS envoy
FROM ${BASE_IMAGE}
RUN apt-get update \
    && apt-get install --yes --no-install-recommends chromium-headless-shell \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65532 keplerops \
    && useradd --system --uid 65532 --gid keplerops \
        --home-dir /nonexistent keplerops
WORKDIR /opt/keplerops
COPY assets/services/keplerops-runtime/requirements.txt ./requirements.txt
COPY assets/services/keplerops-runtime/context-requirements.txt ./context-requirements.txt
COPY assets/services/keplerops-runtime/model-secrets-requirements.txt ./model-secrets-requirements.txt
COPY assets/services/keplerops-runtime/model-backdoor-requirements.txt ./model-backdoor-requirements.txt
COPY assets/services/keplerops-runtime/ai-capstone-requirements.txt ./ai-capstone-requirements.txt
RUN python -m pip install --no-cache-dir \
    --requirement requirements.txt \
    --requirement context-requirements.txt \
    --requirement model-secrets-requirements.txt \
    --requirement model-backdoor-requirements.txt \
    --requirement ai-capstone-requirements.txt
COPY --from=envoy /usr/local/bin/envoy /usr/local/bin/envoy
COPY --from=embedding-model /models/context-embedding /models/context-embedding
COPY assets/model-artifacts/embedding-model.yaml /models/context-embedding/embedding-model.yaml
COPY assets/services/envoy.yaml /etc/keplerops/envoy.yaml
COPY assets/services/gateway-entrypoint.sh /usr/local/bin/gateway-entrypoint
COPY assets/services/keplerops-runtime/app.py ./app.py
COPY assets/services/keplerops-runtime/keplerops_runtime ./keplerops_runtime
COPY assets/services/keplerops-runtime/agent_persistence.py ./agent_persistence.py
COPY assets/services/keplerops-runtime/adversarial_input.py ./adversarial_input.py
COPY assets/services/keplerops-runtime/training_poisoning.py ./training_poisoning.py
COPY assets/services/keplerops-runtime/model_extraction.py ./model_extraction.py
COPY assets/services/keplerops-runtime/model_backdoor.py ./model_backdoor.py
COPY assets/services/keplerops-runtime/ai_capstone.py ./ai_capstone.py
COPY assets/services/keplerops-runtime/agent_worker.py ./agent_worker.py
COPY assets/services/keplerops-runtime/agent_action_worker.py ./agent_action_worker.py
COPY assets/services/keplerops-runtime/agent_actions.py ./agent_actions.py
COPY assets/services/keplerops-runtime/agent_control.py ./agent_control.py
COPY assets/services/keplerops-runtime/model_evasion.py ./model_evasion.py
COPY assets/services/keplerops-runtime/model_supply.py ./model_supply.py
COPY assets/services/keplerops-runtime/python_package_worker.py ./python_package_worker.py
COPY assets/services/keplerops-runtime/workhub_credentials.py ./workhub_credentials.py
COPY assets/services/keplerops-runtime/context_poisoning.py ./context_poisoning.py
COPY assets/services/keplerops-runtime/context_expansion.py ./context_expansion.py
COPY assets/services/keplerops-runtime/model_secrets.py ./model_secrets.py
COPY assets/services/keplerops-runtime/model_secrets_expansion.py ./model_secrets_expansion.py
COPY assets/services/keplerops-runtime/agent_persistence_expansion.py ./agent_persistence_expansion.py
COPY assets/services/keplerops-runtime/domain.py ./domain.py
COPY assets/services/keplerops-runtime/oracle_domain.py ./oracle_domain.py
COPY assets/services/keplerops-runtime/research_domain.py ./research_domain.py
COPY assets/services/keplerops-runtime/research.py ./research.py
COPY assets/services/keplerops-runtime/research_readback.py ./research_readback.py
COPY assets/services/keplerops-runtime/instrumentation.py ./instrumentation.py
COPY aces_contract.py ./aces_contract.py
COPY ctfd/plugins/keplerops_oracle_flags/receipt.py ./receipt.py
COPY telemetry/data-dictionary.md /opt/keplerops/telemetry/data-dictionary.md
COPY sdl/ /opt/keplerops/sdl/
COPY assets/content/credentials/synthetic-defaults.yaml /opt/keplerops/workhub-credentials.yaml
COPY assets/content/datasets/context.jsonl /opt/keplerops/environment/context.jsonl
COPY assets/content/datasets/distillation.jsonl /opt/keplerops/environment/distillation.jsonl
COPY assets/services/agent-control.html /opt/keplerops/ui/agent-control.html
COPY assets/services/model-evasion.html /opt/keplerops/ui/model-evasion.html
COPY assets/services/context-poisoning.html /opt/keplerops/ui/context-poisoning.html
COPY assets/services/model-secrets.html /opt/keplerops/ui/model-secrets.html
COPY assets/services/agent-persistence.html /opt/keplerops/ui/agent-persistence.html
COPY assets/oracle/model-secrets.json /opt/keplerops/oracle/model-secrets.json
COPY assets/oracle/model-extraction.json /opt/keplerops/oracle/model-extraction.json
COPY assets/oracle/model-backdoor.json /opt/keplerops/oracle/model-backdoor.json
COPY assets/model-artifacts/model.yaml /opt/keplerops/environment/model.yaml
RUN chmod 0755 /usr/local/bin/gateway-entrypoint
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/gateway-entrypoint"]
