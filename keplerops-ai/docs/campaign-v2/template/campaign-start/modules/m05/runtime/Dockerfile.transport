FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --system --uid 10002 --create-home --home-dir /var/lib/cinder-orion-transport cinder-transport
COPY --chown=cinder-transport:cinder-transport cinder_transport.py /opt/cinder/cinder_transport.py
USER cinder-transport
WORKDIR /var/lib/cinder-orion-transport
EXPOSE 8090
CMD ["python", "/opt/cinder/cinder_transport.py"]
