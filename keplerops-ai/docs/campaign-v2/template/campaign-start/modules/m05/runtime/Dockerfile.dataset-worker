FROM python:3.10.13-slim-bookworm@sha256:1326d0fd281d283b077fd249e618339a44c9ca5aae6e05cb4f069a087e827922

ARG MLFLOW_VERSION=2.8.1

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ORION_WORKER_HOME=/var/lib/orion-dataset-worker

RUN pip install --no-cache-dir \
      mlflow==${MLFLOW_VERSION} \
      requests==2.31.0 \
      langgraph==0.6.6 \
      PyYAML==6.0.2 \
    && useradd --system --uid 10001 --create-home --home-dir /var/lib/orion-dataset-worker orion-worker \
    && install -d -o orion-worker -g orion-worker -m 0750 \
      /var/lib/orion-dataset-worker/datasets \
      /var/lib/orion-dataset-worker/jobs \
      /var/lib/orion-dataset-worker/python

COPY --chown=orion-worker:orion-worker orion_dataset_worker.py /opt/keplerops/orion_dataset_worker.py
COPY --chown=orion-worker:orion-worker orion_agent_runtime.py /opt/keplerops/orion_agent_runtime.py

USER root
WORKDIR /var/lib/orion-dataset-worker
ENTRYPOINT ["python", "/opt/keplerops/orion_dataset_worker.py"]
