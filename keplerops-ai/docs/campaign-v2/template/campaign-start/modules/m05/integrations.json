    "registry": "robot$orion-review+staging-writer has project-bounded pull/push and no release-project or delete authority",
    "m05_k_to_m09_l": "keplerops/orion-staging contains the immutable .forgejo/workflows/staging-image.yml BuildKit source path; its successful Actions head SHA and Harbor OCI provenance are consumed unchanged by kep-m09-l"
