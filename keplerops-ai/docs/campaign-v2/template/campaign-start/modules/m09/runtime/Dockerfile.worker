FROM python:3.12.11-slim-bookworm

RUN useradd --system --uid 10001 --home-dir /var/lib/orion-import --create-home orion-import \
    && python -m pip install --no-cache-dir \
      boto3==1.40.1 \
      onnxruntime==1.22.1 \
      pika==1.3.2 \
      picklescan==0.0.31 \
      requests==2.32.4 \
      transformers==4.55.4

ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1

COPY import_worker.py /opt/keplerops/import_worker.py
COPY review_dispatcher.py /opt/keplerops/review_dispatcher.py
RUN chmod 0555 /opt/keplerops/import_worker.py /opt/keplerops/review_dispatcher.py

USER 10001:10001
ENTRYPOINT ["python", "/opt/keplerops/import_worker.py"]
