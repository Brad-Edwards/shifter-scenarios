ARG AIRFLOW_IMAGE=keplerops/airflow:campaign-v2-m09
FROM ${AIRFLOW_IMAGE}

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends age docker.io zstd \
    && rm -rf /var/lib/apt/lists/*
USER airflow
RUN python -m pip install --no-cache-dir great-expectations==1.7.1 fastapi==0.116.1 uvicorn==0.35.0 pika==1.3.2 kubernetes==32.0.1
