#!/usr/bin/env bash
set -Eeuo pipefail

export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
readonly NAMESPACE=cinder
read -r action service image domain extra <<<"${SSH_ORIGINAL_COMMAND:-}"

valid_service() { [[ $1 =~ ^[a-z0-9][a-z0-9-]{2,30}$ ]]; }
valid_domain() { [[ $1 =~ ^[a-z0-9][a-z0-9-]{2,30}\.cinder\.lab$ ]]; }
valid_image() { [[ $1 =~ ^registry\.keplerops\.lab/cinder/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; }

case "$action" in
  deploy)
    [[ -z ${extra:-} ]] && valid_service "$service" && valid_image "$image" && valid_domain "$domain"
    cat <<EOF | k3s kubectl apply -f - >/dev/null
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: ${service}
  namespace: ${NAMESPACE}
  labels:
    cinder.keplerops.lab/owner: cinder-operator
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/min-scale: "0"
        autoscaling.knative.dev/max-scale: "1"
    spec:
      containerConcurrency: 20
      containers:
        - image: ${image}
          ports: [{containerPort: 8080}]
          resources:
            requests: {cpu: 25m, memory: 32Mi}
            limits: {cpu: 500m, memory: 256Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
            runAsNonRoot: true
            seccompProfile: {type: RuntimeDefault}
---
apiVersion: serving.knative.dev/v1beta1
kind: DomainMapping
metadata:
  name: ${domain}
  namespace: ${NAMESPACE}
spec:
  ref:
    name: ${service}
    kind: Service
    apiVersion: serving.knative.dev/v1
EOF
    k3s kubectl -n "$NAMESPACE" wait --for=condition=Ready "kservice/${service}" --timeout=5m >/dev/null
    ;;
  status)
    [[ -z ${image:-}${domain:-}${extra:-} ]] && valid_service "$service"
    ;;
  delete)
    [[ -z ${image:-}${domain:-}${extra:-} ]] && valid_service "$service"
    k3s kubectl -n "$NAMESPACE" delete kservice "$service" --ignore-not-found >/dev/null
    ;;
  *)
    printf 'allowed commands: deploy <service> <image@sha256> <domain>, status <service>, delete <service>\n' >&2
    exit 2
    ;;
esac

if [[ $action != delete ]]; then
  ready_replicas="$(k3s kubectl -n "$NAMESPACE" get pods -l "serving.knative.dev/service=${service}" -o json | jq '[.items[] | select(.status.phase == "Running")] | length')"
  k3s kubectl -n "$NAMESPACE" get kservice "$service" -o json | jq --argjson ready_replicas "$ready_replicas" '{
    service:.metadata.name,
    owner:.metadata.labels["cinder.keplerops.lab/owner"],
    image:.spec.template.spec.containers[0].image,
    url:.status.url,
    latest_created_revision:.status.latestCreatedRevisionName,
    latest_ready_revision:.status.latestReadyRevisionName,
    ready:(.status.conditions[] | select(.type=="Ready") | .status),
    ready_replicas:$ready_replicas
  }'
fi
