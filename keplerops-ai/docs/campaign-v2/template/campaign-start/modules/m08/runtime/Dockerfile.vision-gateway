FROM python:3.12.11-slim

RUN pip install --no-cache-dir \
      boto3==1.40.20 \
      fastapi==0.116.1 \
      requests==2.32.4 \
      uvicorn==0.35.0

COPY campaign-start/modules/m08/runtime/vision_gateway.py /app/vision_gateway.py

USER 65532:65532
EXPOSE 8080
CMD ["uvicorn", "vision_gateway:app", "--app-dir", "/app", "--host", "0.0.0.0", "--port", "8080"]
