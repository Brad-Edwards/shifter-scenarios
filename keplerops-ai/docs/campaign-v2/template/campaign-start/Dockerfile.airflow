ARG AIRFLOW_IMAGE=keplerops/airflow:campaign-v2-clean
FROM ${AIRFLOW_IMAGE}

COPY campaign-start/modules/m05/payloads/airflow/orion_evaluation_replay.py /opt/airflow/dags/orion_evaluation_replay.py

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      age bubblewrap docker.io openssh-client openssl zstd \
    && rm -rf /var/lib/apt/lists/*

USER airflow
RUN python -m pip install --no-cache-dir \
      great-expectations==1.7.1 \
      pillow==11.3.0 \
      pika==1.3.2 \
      picklescan==0.0.31 \
    && python -m pip install --no-cache-dir --no-deps lpips==0.1.4 \
    && python -m pip install --no-cache-dir --no-deps \
      --index-url https://download.pytorch.org/whl/cpu \
      torchvision==0.23.0+cpu

RUN python -c 'import lpips; lpips.LPIPS(net="alex")'
