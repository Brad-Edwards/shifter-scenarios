ARG AIRFLOW_IMAGE=keplerops/airflow:campaign-v2-m08
FROM ${AIRFLOW_IMAGE}

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      age docker.io openssh-client zstd \
    && rm -rf /var/lib/apt/lists/*

USER airflow
RUN python -m pip install --no-cache-dir \
      great-expectations==1.7.1 \
      pika==1.3.2 \
      picklescan==0.0.31
