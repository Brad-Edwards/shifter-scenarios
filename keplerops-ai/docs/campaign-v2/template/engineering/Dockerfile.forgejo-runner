ARG FORGEJO_RUNNER_BASE_IMAGE=code.forgejo.org/forgejo/runner:6.3.1
ARG CI_TOOLCHAIN_BASE_IMAGE=node:22.18-bookworm-slim
ARG DOCKER_CLI_IMAGE=docker:28.5.1-cli
ARG CRANE_IMAGE=gcr.io/go-containerregistry/crane:v0.21.8
ARG COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v2.4.1
ARG YQ_IMAGE=mikefarah/yq:4.44.3
FROM ${FORGEJO_RUNNER_BASE_IMAGE} AS forgejo-runner
FROM ${DOCKER_CLI_IMAGE} AS docker-cli
FROM ${CRANE_IMAGE} AS crane
FROM ${COSIGN_IMAGE} AS cosign
FROM ${YQ_IMAGE} AS yq
FROM ${CI_TOOLCHAIN_BASE_IMAGE}

USER root
COPY --from=forgejo-runner /bin/forgejo-runner /bin/forgejo-runner
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
COPY --from=crane /ko-app/crane /usr/local/bin/crane
COPY --from=cosign /ko-app/cosign /usr/local/bin/cosign
COPY --from=yq /usr/bin/yq /usr/local/bin/yq
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      ca-certificates \
      curl \
      git \
      jq \
      python3 \
      python3-pip \
      python3-venv \
    && python3 -m venv /opt/kepler-ci \
    && /opt/kepler-ci/bin/pip install --no-cache-dir \
      build==1.3.0 \
      setuptools==80.9.0 \
      twine==6.2.0 \
      wheel==0.45.1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/kepler-ci/bin:${PATH}"
