[Unit]
Description=KeplerOps AI Systems campaign-v2 template
After=docker.service libvirtd.service network-online.target
Requires=docker.service libvirtd.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/keplerops-v2/scripts/start-all.sh resume
RemainAfterExit=yes
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
