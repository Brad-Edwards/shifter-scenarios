{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shifter.paloaltonetworks.com/cinder-typhoon/challenge-delivery-v2.schema.json",
  "title": "Cinder Typhoon participant challenge delivery",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "scoring", "summary", "phases"],
  "properties": {
    "schema": {"const": "cinder-typhoon.challenge-delivery/v2"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "tier_points", "max_score", "max_out", "hint_policy"],
      "properties": {
        "model": {"const": "static"},
        "tier_points": {
          "const": {"easy": 50, "medium": 100, "hard": 200, "expert": 400, "elite": 800}
        },
        "max_score": {"const": 39200},
        "max_out": {"type": "string", "minLength": 1},
        "hint_policy": {
          "const": {
            "release": "facilitator_on_request",
            "levels": 3,
            "independent_levels": true,
            "penalty": 0
          }
        }
      }
    },
    "summary": {
      "const": {"operation_count": 70, "card_count": 240}
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training", "keplerops", "arwc"],
      "properties": {
        "training": {"$ref": "#/$defs/phase"},
        "keplerops": {"$ref": "#/$defs/phase"},
        "arwc": {"$ref": "#/$defs/phase"}
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "operation_count", "card_count", "score_total", "operations"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "operation_count": {"type": "integer", "minimum": 1},
        "card_count": {"type": "integer", "minimum": 1},
        "score_total": {"type": "integer", "minimum": 1},
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chapter", "title", "allocation", "cards"],
      "properties": {
        "id": {"type": "string", "pattern": "^[TKW][0-9]{2}$"},
        "chapter": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "allocation": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "easy": {"type": "integer", "minimum": 1},
            "medium": {"type": "integer", "minimum": 1},
            "hard": {"type": "integer", "minimum": 1},
            "expert": {"type": "integer", "minimum": 1},
            "elite": {"type": "integer", "minimum": 1}
          }
        },
        "cards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/card"}}
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "difficulty", "points", "hints", "completion"],
      "properties": {
        "id": {"type": "string", "pattern": "^[TKW][0-9]{2}\\.[0-9]+$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "difficulty": {"enum": ["easy", "medium", "hard", "expert", "elite"]},
        "points": {"type": "integer", "minimum": 1},
        "hints": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "completion": {
          "const": {"mode": "automatic_range_evidence"}
        }
      }
    }
  }
}
