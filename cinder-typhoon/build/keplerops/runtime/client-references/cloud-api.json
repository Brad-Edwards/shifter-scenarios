        {
          "key": "cloud.maintenance",
          "method": "GET",
          "template": "https://cloud-api.keplerops.test/api/maintenance"
        },
        {
          "key": "cloud.policy",
          "method": "GET",
          "template": "https://cloud-api.keplerops.test/api/policies/{policy_id}"
