{
  "documents": {
    "preview.keplerops.test": {
      "title": "FieldKest preview and document rendering services",
      "purpose": "Render support attachments and retrieve preview associations.",
      "routes": [
        {
          "key": "preview.association",
          "method": "GET",
          "template": "https://preview.keplerops.test/api/preview/association?source={source_id}"
        },
        {
          "key": "preview.documents",
          "method": "POST",
          "template": "https://preview.keplerops.test/api/preview/documents"
        },
        {
          "key": "preview.render",
          "method": "POST",
          "template": "https://preview.keplerops.test/api/preview/render"
        },
        {
          "key": "preview.review",
          "method": "GET",
          "template": "https://preview.keplerops.test/api/preview/reviews/{review_id}"
        },
        {
          "key": "preview.assignment",
          "method": "PATCH",
          "template": "https://preview.keplerops.test/api/preview/reviews/{review_id}/assignment"
        },
        {
          "key": "preview.prepare",
          "method": "POST",
          "template": "https://preview.keplerops.test/api/preview/reviews/{review_id}/prepare"
        },
        {
          "key": "preview.attachment",
          "method": "GET",
          "template": "https://preview.keplerops.test/attachment/{source_id}"
        },
        {
          "key": "preview.release",
          "method": "GET",
          "template": "https://preview.keplerops.test/api/preview/release/{review_id}"
        }
      ]
    }
  }
}