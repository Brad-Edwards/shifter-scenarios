{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shifter.paloaltonetworks.com/cinder-typhoon/participant-surface/observed-v1.schema.json",
  "title": "Cinder Typhoon observed participant-surface manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "phase",
    "state",
    "participant",
    "filesystem",
    "tools",
    "network",
    "security"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_kind": {"const": "observed"},
    "phase": {"enum": ["training", "keplerops", "arwc"]},
    "state": {"type": "string", "minLength": 1},
    "participant": {"$ref": "#/$defs/participant"},
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "forbidden_paths"],
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/root"}
        },
        "forbidden_paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/forbidden_path"}
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {"$ref": "#/$defs/tool"}
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dns", "listeners"],
      "properties": {
        "dns": {"type": "array", "items": {"$ref": "#/$defs/dns"}},
        "listeners": {"type": "array", "items": {"$ref": "#/$defs/listener"}}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unprivileged", "docker_socket_readable", "operator_tests_visible"],
      "properties": {
        "unprivileged": {"type": "boolean"},
        "docker_socket_readable": {"type": "boolean"},
        "operator_tests_visible": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "uid", "group", "gid", "groups", "home", "workdir"],
      "properties": {
        "user": {"type": "string", "minLength": 1},
        "uid": {"type": "integer", "minimum": 1},
        "group": {"type": "string", "minLength": 1},
        "gid": {"type": "integer", "minimum": 1},
        "groups": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "home": {"type": "string", "pattern": "^/"},
        "workdir": {"type": "string", "pattern": "^/"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "mode", "owner", "group"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "type": {"enum": ["directory", "file", "symlink", "other"]},
        "mode": {"type": "string", "pattern": "^[0-7]{4}$"},
        "owner": {"type": "string", "minLength": 1},
        "group": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target": {"type": "string"},
        "hash_error": {"type": "string", "minLength": 1},
        "target_error": {"type": "string", "minLength": 1}
      }
    },
    "observation_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "error"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "error": {"type": "string", "minLength": 1}
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "entries", "errors"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/observation_error"}}
      }
    },
    "forbidden_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "visible", "readable"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "visible": {"type": "boolean"},
        "readable": {"type": "boolean"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "executable"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {
          "anyOf": [
            {"type": "string", "pattern": "^/"},
            {"type": "null"}
          ]
        },
        "executable": {"type": "boolean"}
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "addresses"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "addresses": {
          "type": "array",
          "items": {"type": "string", "format": "ipv4"},
          "uniqueItems": true
        }
      }
    },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "reachable"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "reachable": {"type": "boolean"}
      }
    }
  }
}
