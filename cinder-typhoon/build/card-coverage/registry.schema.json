{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shifter.paloaltonetworks.com/cinder-typhoon/card-coverage/registry.schema.json",
  "title": "Cinder Typhoon card coverage registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authored_card_source", "delivery_catalog", "read_only_review_source", "cards"],
  "properties": {
    "schema_version": {"const": 3},
    "authored_card_source": {"type": "string"},
    "delivery_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "revision", "sha256", "operation_count", "card_count", "score_total"],
      "properties": {
        "path": {"const": "challenges/challenges.yaml"},
        "schema": {"const": "cinder-typhoon.challenge-delivery/v2"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "operation_count": {"const": 70},
        "card_count": {"const": 240},
        "score_total": {"type": "integer", "minimum": 1}
      }
    },
    "read_only_review_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "build/card-coverage/read-only-reviews.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "cards": {"type": "object", "minProperties": 240, "maxProperties": 240}
  }
}
