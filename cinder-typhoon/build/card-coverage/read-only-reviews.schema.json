{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shifter.paloaltonetworks.com/cinder-typhoon/card-coverage/read-only-reviews.schema.json",
  "title": "Cinder Typhoon read-only interpretation reviews",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviews"],
  "properties": {
    "schema_version": {"const": 1},
    "reviews": {
      "type": "object",
      "propertyNames": {"pattern": "^[TKW][0-9]{2}\\.[0-9]$"},
      "additionalProperties": {"type": "string", "minLength": 80}
    }
  }
}
