[Unit]
Description=Cinder Typhoon ARWC clone carrier-address binding
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/cinder-arwc-clone-boot
RemainAfterExit=yes
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
