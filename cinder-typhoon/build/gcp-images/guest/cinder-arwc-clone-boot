#!/usr/bin/env bash
# Bind the ARWC FieldLink edge to this clone's carrier address at boot.
# A stateful clone of the golden ARWC keeps the golden's published address
# on fieldlink-edge. This step recreates only that container with the
# address of the current VM. It does not change any other service.
set -euo pipefail

[[ $EUID == 0 ]] || exit 1
systemctl start docker
cd /opt/arwc-ot-compat/slice

for attempt in $(seq 1 120); do
  if [[ $(docker inspect --format '{{.State.Running}}' arwc-ot-compat-plc-1 2>/dev/null || true) == true ]]; then
    break
  fi
  [[ $attempt != 120 ]] || {
    echo 'ARWC PLC did not become ready.' >&2
    exit 1
  }
  sleep 5
done

metadata=http://metadata.google.internal/computeMetadata/v1
address=$(curl --fail --silent --show-error --header 'Metadata-Flavor: Google' \
  "$metadata/instance/network-interfaces/0/ip")
[[ $address =~ ^(10|172\.(1[6-9]|2[0-9]|3[01])|192\.168)\. ]] || {
  echo "Unexpected ARWC carrier address: $address" >&2
  exit 1
}

export ARWC_CARRIER_ADDRESS=$address
export ARWC_OT_OPERATOR_DIR=$PWD/.operator
it=/opt/arwc-ot-compat/it/cinder-typhoon/build/arwc
docker compose -f "$it/compose.yaml" -f "$PWD/integration/it-compose.yaml" \
  up -d --no-deps --no-build --pull never fieldlink-edge

published=$(docker port cinder-arwc-fieldlink-edge 443/tcp)
[[ $published == "$address:443" ]] || {
  echo "fieldlink-edge publishes $published, expected $address:443" >&2
  exit 1
}
echo "ARWC fieldlink-edge bound to $address:443"

# Mint a fresh step-ca OTT pool for the archive enrollment at first boot (W04.2).
# The bake reset mints the pool relative to bake time, so on a cloned range the
# tokens have expired long before a participant boots. Re-mint here with the
# event-covering validity (336h from first boot) so archive enrollment works for
# the whole range lifetime. A mint failure warns but does not fail the boot.
if [[ -x "$it/native/manage.sh" ]]; then
  ( cd "$it/native" && bash manage.sh mint-ott-pool 336h ) \
    || echo 'warning: step-ca OTT pool mint at clone boot failed' >&2
fi
