{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shifter.paloaltonetworks.com/cinder-typhoon/hint-delivery-manifest.schema.json",
  "title": "Cinder Typhoon hint delivery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "schema",
    "catalog",
    "sources",
    "release",
    "score_effect",
    "review",
    "playtest_evidence",
    "summary",
    "items"
  ],
  "properties": {
    "revision": {"$ref": "#/$defs/digest"},
    "schema": {"const": "cinder-typhoon.hint-delivery/v1"},
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "revision"],
      "properties": {
        "schema": {"const": "cinder-typhoon.challenge-delivery/v2"},
        "revision": {"$ref": "#/$defs/digest"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "path", "sha256", "card_count", "hint_count"],
        "properties": {
          "phase": {"enum": ["training", "keplerops", "arwc"]},
          "path": {"type": "string", "pattern": "^build/card-coverage/hints-(training|keplerops|arwc)\\.yaml$"},
          "sha256": {"$ref": "#/$defs/digest"},
          "card_count": {"type": "integer", "minimum": 1},
          "hint_count": {"type": "integer", "minimum": 3}
        }
      }
    },
    "release": {
      "const": {
        "mode": "facilitator_on_request",
        "levels": [1, 2, 3],
        "independent_levels": true,
        "audit": "append_only_metadata_without_hint_text"
      }
    },
    "score_effect": {"const": {"penalty": 0, "maximum_score_unchanged": true}},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "operation_count"],
      "properties": {
        "path": {"const": "build/hint-delivery/operation-reviews.json"},
        "sha256": {"$ref": "#/$defs/digest"},
        "operation_count": {"const": 70}
      }
    },
    "playtest_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_path", "schema_sha256", "required_fields"],
      "properties": {
        "schema_path": {"const": "build/hint-delivery/playtest-observation.schema.json"},
        "schema_sha256": {"$ref": "#/$defs/digest"},
        "required_fields": {
          "const": ["card_id", "level_observations", "observer_notes"]
        }
      }
    },
    "summary": {
      "const": {"operation_count": 70, "card_count": 240, "hint_count": 720}
    },
    "items": {
      "type": "array",
      "minItems": 240,
      "maxItems": 240,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["client_route", "participant_artifact", "participant_service", "starting_material"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "sha256"],
      "properties": {
        "level": {"type": "integer", "minimum": 1, "maximum": 3},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "operation_id", "phase", "levels", "references"],
      "properties": {
        "card_id": {"type": "string", "pattern": "^[TKW][0-9]{2}\\.[0-9]+$"},
        "operation_id": {"type": "string", "pattern": "^[TKW][0-9]{2}$"},
        "phase": {"enum": ["training", "keplerops", "arwc"]},
        "levels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/level"}
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/reference"}
        }
      }
    }
  }
}
